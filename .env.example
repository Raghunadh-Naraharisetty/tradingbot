# Environment Variables for Trading Bot
# ======================================
# Copy this file to .env and fill in your values

# Telegram Bot Configuration - SIMPLE SYSTEM (2-strategy)
# --------------------------------------------------------
# Get these from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Telegram Bot Configuration - MULTI5 SYSTEM (5-strategy)
# --------------------------------------------------------
# OPTIONAL: Create a second bot for Multi5 system
# If you don't create a second bot, Multi5 will use the same bot above
TELEGRAM_BOT_TOKEN_MULTI5=your_multi5_bot_token_here
TELEGRAM_CHAT_ID_MULTI5=your_chat_id_here

# Trading Configuration (Optional - can also use config.py)
# ----------------------------------------------------------
# INITIAL_CAPITAL=100.00
# PAPER_TRADING=True

# Cloud Deployment (For future use)
# ----------------------------------
# AWS_ACCESS_KEY=your_aws_key
# AWS_SECRET_KEY=your_aws_secret
# DATABASE_URL=your_database_url

# Logging
# -------
LOG_LEVEL=INFO
